---
// The developer signup form was retired. Requests now go through the demo
// request form on tolka.health, which carries the privacy notice.
const target = 'https://tolka.health/pilot#book-demo';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Request access</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 36rem; margin: 4rem auto; padding: 0 1rem; line-height: 1.6">
    <h1>Request access</h1>
    <p>
      Access requests now go through the demo request form on our main site.
      <a href={target}>Open the form</a>.
    </p>
  </body>
</html>
